     "text": [
      "\n",
      "Bot : Hello. Is there something I can help you with or would you like to chat?\n"
     ]
    },
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "\n",
      "Ask :  q\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Bye 👋\n"
     ]
    }
   ],
   "source": [
    "from langchain_ollama import OllamaLLM\n",
    "\n",
    "llm = OllamaLLM(model=\"llama3.2:1b\")\n",
    "\n",
    "while True:\n",
    "\n",
    "    question = input(\"\\nAsk : \")\n",
    "\n",
    "    if question == \"q\":\n",
    "        print(\"Bye 👋\")\n",
    "        break\n",
    "\n",
    "    response = llm.invoke(question)\n",
    "\n",
    "    print(\"\\nBot :\", response)"
   ]
  },
